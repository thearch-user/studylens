# Option A: OpenRouter. Keep this server-side; never use NEXT_PUBLIC_ for secrets.
OPENROUTER_API_KEY=
# Free OpenRouter model router. It selects a free model that supports the request.
OPENROUTER_MODEL=openrouter/free
# Usually leave this alone.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional app attribution shown in OpenRouter dashboards/rankings.
OPENROUTER_APP_TITLE=StudyLens
OPENROUTER_HTTP_REFERER=http://localhost:3000

# Option B: OpenAI hosted API.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Optional absolute path outside public/. Defaults to ./db/local.
# STUDYLENS_DATA_DIR=/home/your-user/.local/share/studylens

# Option C: local/OpenAI-compatible Responses API endpoint.
# If this is not api.openai.com, OPENAI_API_KEY may be left empty.
# The endpoint must support POST /v1/responses and structured JSON output.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Example local endpoint:
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=local-model-name
